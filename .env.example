# Chakra Healing YouTube Automation Configuration

# Google Drive Folders (Add your specific folder IDs here)
GOOGLE_DRIVE_VIDEO_FOLDER_ID=your_chakra_videos_folder_id
GOOGLE_DRIVE_AUDIO_FOLDER_ID=your_chakra_audio_folder_id
GOOGLE_DRIVE_IMAGE_FOLDER_ID=your_chakra_images_folder_id

# Google Service Account Authentication
GOOGLE_SERVICE_ACCOUNT_KEY=service_account.json

# YouTube Data API Credentials (OAuth 2.0)
YT_CLIENT_ID=your_youtube_client_id
YT_CLIENT_SECRET=your_youtube_client_secret
YT_REFRESH_TOKEN=your_youtube_refresh_token

# Channel Configuration
# Recommended Channel Names: ChakraSanctum | PranaResonance | AuraHarmonics | GoldenPrana | AnandaChakra
CHANNEL_NAME=ChakraSanctum
DEFAULT_DURATION=3600
ALLOW_REPOST=true

# Local Directories Fallback
LOCAL_VIDEO_DIR=input_videos
LOCAL_AUDIO_DIR=input_audio
LOCAL_IMAGE_DIR=input_images
